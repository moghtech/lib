{
  "name": "mogh_ui",
  "version": "3.1.0",
  "description": "Common UI components and styling used across Mogh apps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./index.scss": "./dist/index.scss",
    "./theme.scss": "./dist/theme.scss"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && cd src && find . -name '*.scss' -exec cp --parents {} ../dist \\;",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/form": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^9.2.6",
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "^1.52.0",
    "mogh_auth_client": "^7.0.0",
    "mogh_supporter": "^1.0.0",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sass": "^1.105.1",
    "sass-embedded": "^1.105.1"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/form": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/query-core": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.52.0",
    "mogh_auth_client": "^7.0.0",
    "mogh_supporter": "^1.0.0",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
